# Server-only MiniMax credential. Configure the real value in .env.local or
# Vercel Environment Variables; never commit it or expose it as NEXT_PUBLIC_*.
MINIMAX_API_KEY=""

# Optional request timeout for the local backend -> MiniMax call.
MINIMAX_TIMEOUT_MS="20000"

# Local development server options.
HOST="127.0.0.1"
PORT="3001"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
