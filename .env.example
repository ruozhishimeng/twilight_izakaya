# The production game never reads an API key from this file.
# Players enter their own MiniMax key in the in-game settings for each run.

# Optional request timeout for the local backend -> MiniMax call.
MINIMAX_TIMEOUT_MS="20000"

# Local development server options.
HOST="127.0.0.1"
PORT="3001"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
